    },
    {
      "address": "40001",
      "type": "FLOAT32",
      "byteOrder": "AB CD",
      "description": "BatteryChargePower_SP",
      "unit": "W",
      "direction": "ReadWrite",
      "vizType": "gauge"
    },
    {
      "address": "40003",
      "type": "FLOAT32",
      "byteOrder": "AB CD",
      "description": "BatteryDischargeLimit_SP",
      "unit": "W",
      "direction": "ReadWrite",
      "vizType": "gauge"
    }
  ]
