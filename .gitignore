influxdb/data/
grafana/data/
mosquitto/data/
mosquitto/log/

# ════════════════════════════════════════════════════════════════════
#  Generated files — recreated automatically by the tools
# ════════════════════════════════════════════════════════════════════
GUI/generated_aas.aasx
GUI/ContainerManager.aasx
GUI/connection.json
GUI/databridge_config/
